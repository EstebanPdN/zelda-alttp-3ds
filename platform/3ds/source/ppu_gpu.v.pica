; Packed pixel-edge x/y/depth/w, UV and RGBA: 16 bytes per vertex.
; Move coordinate conversion to PICA rather than repeating CPU float work.
.fvec positionScale
; eyeParams = (pixels per depth unit for this eye, -reference depth,
;               minimum depth that receives parallax, maximum depth offset)
; Parallax depends only on layer depth, so every quad is shifted by one
; constant amount (no per-scanline shear, no stair-steps on edges). The whole
; scene sits slightly behind the screen (recess); layers in front pop out.
; Sprites get a layer term that grows with height above their feet (the
; vertex w carries 2+lean, lean 0..4096, computed per character on the CPU), a
; quarter of which is applied: feet stay on the ground plane and the upper body
; leans toward the viewer, like the Minish Cap port. Background layers are capped lower (eyeParams.w) to soften the
; boxy look of columns and doorways. Vertex w is 1 for BG layers and 2 for
; sprites; w is restored to 1 for the output.
.fvec eyeParams
; spriteParams.x = layer term of a fully raised sprite point (lean 4096);
; raised on the title screen so the Triforce pops out
.fvec spriteParams
.constf positionOffset(-1.0, 1.0, 0.0, 0.0)
.constf one(1.0, 1.0, 1.0, 1.0)
.constf spriteK(-0.75, 1.75, 0.0, 0.0)
.constf recess(-2500.0, 0.0, 0.0, 0.0)
.constf ground(1920.0, 0.0, 0.0, 0.0)
.constf scale(0.000244140625, 0.000244140625, 0.003921568627451, 1.0)
.out outpos position
.out outcolor color
.out outtc0 texcoord0
.out outtc1 texcoord1
.alias inpos v0
.alias intex v1
.alias incolor v2
.proc main
    mul r0, positionScale, inpos
    mov r3, eyeParams
    mov r8, spriteParams
    ; layer term: depth relative to the ground layer, capped
    add r1, inpos.zzzz, r3.yyyy
    ; both ground layers (BG2 low, BG1 low) count as depth 0, so characters
    ; look the same on either floor; layers behind the ground stay behind
    min r5, recess.yyyy, r1
    add r1, -ground.xxxx, r1
    max r1, r1, r5
    min r1, r1, r3.wwww
    ; r6 = 1 for sprites (w>=2), 0 for BG layers (w=1)
    add r6, -one.xxxx, inpos.wwww
    min r6, r6, one.xxxx
    ; sprite layer term = lean * spriteParams.x, lean = (w-2)/4096: feet at
    ; the ground plane (0), upper body raised, same shift for a whole row
    add r7, inpos.wwww, -one.xxxx
    add r7, r7, -one.xxxx
    max r7, r7, recess.yyyy
    mul r7, r7, scale.xxxx
    mul r7, r7, r8.xxxx
    add r5, r7, -r1
    mul r5, r5, r6
    add r1, r1, r5
    ; sprites keep a quarter of the layer term
    mul r4, spriteK.xxxx, r6
    add r4, one.xxxx, r4
    mul r1, r1, r4
    add r1, recess.xxxx, r1
    ; no parallax for the backdrop and compose quads
    sge r2, inpos.zzzz, r3.zzzz
    mul r1, r1, r2
    mul r1, r1, r3.xxxx
    mul r1, positionScale.xxxx, r1
    add r0.x, r0.xxxx, r1.xxxx
    mov r0.w, one
    add outpos, positionOffset, r0
    mul outtc0, scale, intex
    mul outtc1, scale, intex
    mul outcolor, scale.zzzz, incolor
    end
.end
